{
    "name": "super-kernel/swoole",
    "description": "Swoole console commands and main process supervision for SuperKernel.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": ">=8.4.27 <8.5",
        "ext-pcntl": "*",
        "ext-swoole": ">=6.2.3 <6.3",
        "psr/container": "^2.0.2",
        "psr/event-dispatcher": "^1.0",
        "super-kernel/attribute": "dev-main",
        "super-kernel/command": "dev-main",
        "super-kernel/config": "dev-main",
        "super-kernel/contract": "dev-main",
        "super-kernel/server": "dev-main",
        "symfony/console": "^8.1.9"
    },
    "require-dev": {
        "ext-posix": "*",
        "friendsofphp/php-cs-fixer": "^3.95.27",
        "phpunit/phpunit": "^13.4.5"
    },
    "autoload": {
        "psr-4": {
            "SuperKernel\\Swoole\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SuperKernel\\Swoole\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "format": "@php vendor/bin/php-cs-fixer fix --show-progress=bar --no-ansi",
        "format:check": "@php vendor/bin/php-cs-fixer check --show-progress=bar --no-ansi --diff",
        "test": "@php vendor/bin/phpunit"
    }
}
